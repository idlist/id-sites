{
  "lineWidth": 100,
  "typescript": {
    "semiColons": "asi",
    "quoteStyle": "alwaysSingle"
  },
  "json": {
    "trailingCommas": "jsonc"
  },
  "markdown": {
    "emphasisKind": "asterisks",
    "table.cellPadding": "space"
  },
  "malva": {
    "printWidth": 80
  },
  "markup": {
  },
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "**/*.svg"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.24.0",
    "npm:@dprint/markdown@0.28.2",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.3"
  ]
}
