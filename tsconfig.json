{
  "extends": "astro/tsconfigs/base",
  "include": [".astro/types.d.ts", "astro.config.ts", "src/**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "@t/*": ["./src/types/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@home/*": ["./src/sections/home/*"],
      "@notes/*": ["./src/sections/notes/*"]
    },
    "jsx": "preserve"
  }
}
