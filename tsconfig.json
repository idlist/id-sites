{
  "extends": "astro/tsconfigs/base",
  "include": [
    ".astro/types.d.ts",
    "astro.config.ts",
    "vitest.config.ts",
    "src/**/*",
    "scripts/**/*",
    "virtual-i18n/**/*"
  ],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "preserve",
    "paths": {
      "@virtual-i18n/*": ["./virtual-i18n/*"],
      "@src/*": ["./src/*"],
      "@assets/*": ["./src/assets/*"],
      "@styles/*": ["./src/styles/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@home/*": ["./src/home/*"],
      "@client/*": ["./src/client/*"]
    }
  }
}
