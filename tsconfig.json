{
  "extends": "astro/tsconfigs/base",
  "include": [
    ".astro/types.d.ts",
    "astro.config.ts",
    "vitest.config.ts",
    "src/**/*",
    "virtual-i18n/**/*"
  ],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "preserve",
    "paths": {
      "@styles/*": ["./src/styles/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@home/*": ["./src/home/*"],
      "@compo/*": ["./src/components/*"]
    }
  }
}
