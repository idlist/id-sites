---
import BackgroundDots from '@layouts/components/BackgroundDots.astro'
import Base, { type BaseProps } from './Base.astro'

export interface NotesProps extends BaseProps {
}

interface Props extends NotesProps {
}

const { locale, title } = Astro.props
---

<Base locale={locale} title={title}>
  <BackgroundDots />
  <slot />
</Base>

<style>
body {
  background-color: var(--color-sub);
  color: var(--color-main);
}
</style>
