---
import '@styles/reset.css'
import '@styles/globals.scss'
import type { SupportedLocales } from 'virtual:i18n'

export interface BaseProps {
  locale?: SupportedLocales
  title: string
}

interface Props extends BaseProps {
}

const { locale = 'en', title } = Astro.props

const langMap = {
  en: 'en',
  zh: 'zh-Hans',
}
---

<!DOCTYPE html>

<html lang={langMap[locale]}>
  <head>
    <title>{title}</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="preload" href="/fonts/exo.medium.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/exo.demi-bold.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/inter.vf.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/inter.vf.italic.woff2" as="font" type="font/woff2" crossorigin>
    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>
