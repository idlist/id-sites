---
import IconIdlist from '@assets/idlist-dark.svg'
import IconIslandSmall from '@assets/island-small.svg'
import IconIsland from '@assets/island.svg'
import type { MDXInstance } from 'astro'
import { getCollection } from 'astro:content'
import type { SupportedLocales } from 'virtual:i18n'
import BubbleRect20 from './components/BubbleRect20.astro'
import GotoOverlayAstro from './components/GotoOverlayAstro.vue'
import NoteEntry, { type NoteEntryProps } from './components/NoteEntry.astro'
import NotesFooter from './components/NotesFooter.astro'
import NotesTopicGroup from './components/NotesTopicGroup.astro'
import ShowdownMask from './components/ShowdownMask.astro'
import { useI18n } from './i18n'
import NotesBase, { type NotesProps } from './NotesBase.astro'

interface NoteTopic {
  /** Topic name. */
  name: string
  /** Brief introduction to the topic.  */
  info?: string
}

export interface NotesByTopic extends NoteTopic {
  draft?: boolean
  /** File path related to `/notes`. */
  entries: string[]
}

interface NoteEntriesByTopic extends NoteTopic {
  entries: NoteEntryProps[]
}

interface Props extends NotesProps {
  topics: NotesByTopic[]
}

const {
  locale = 'en',
  title,
  topics: rawTopics,
} = Astro.props
const { m } = useI18n(locale)

const topics: NoteEntriesByTopic[] = []

for (const rawTopic of rawTopics) {
  if (rawTopic.draft) continue

  const filePaths = new Set(
    rawTopic.entries.map((entry) => `src/notes/${entry}`),
  )

  const notes = await getCollection('notes', (note) => {
    return filePaths.has(note.filePath ?? '')
  })

  const topic: NoteEntriesByTopic = {
    name: rawTopic.name,
    info: rawTopic.info,
    entries: notes.map((note) => ({
      title: note.data.title,
      route: note.data.route,
      date: note.data.created,
    })),
  }

  topics.push(topic)
}

const localePageMap: Record<SupportedLocales, string> = {
  en: '/notes/en',
  zh: '/notes/zh',
}

const NoteListPreface = (await import(
  `./components/NotesListPreface.${locale}.mdx`
) as MDXInstance<{}>).default
---

<NotesBase locale={locale} title={title}>
  <div class="notes-list">
    <main class="main">
      <div class="notes-header">
        <div class="title-icon"><IconIsland /></div>
        <h1 class="title-name">{m('notesListTitle')}</h1>
      </div>

      <BubbleRect20>
        <div class="notes-list-content">
          <div class="preface">
            <NoteListPreface />
          </div>

          {topics.length == 0
            ? <div class="no-notes">{m('noNotes')}</div>
            : topics.map((topic) => (
              <NotesTopicGroup name={topic.name}>
                {topic.info && <div class="topic-info">{topic.info}</div>}
                {topic.entries.map((entry) => <NoteEntry entry={entry} />)}
              </NotesTopicGroup>
            ))}

          <div class="epilog-text">
            <div class="icon"><IconIslandSmall /></div>
            <p>{m('notesEpilog')}</p>
          </div>

          <div class="author-icon">
            <div class="icon"><IconIdlist /></div>
          </div>

          <NotesFooter locale={locale} />
        </div>
      </BubbleRect20>
    </main>
  </div>

  <GotoOverlayAstro
    client:only="vue"
    locale={locale}
    locale-page-map={localePageMap}
  />
  <ShowdownMask />
</NotesBase>

<style lang="scss">
.notes-list {
  padding: 2rem 1rem 2rem 1rem;
  display: flex;
  justify-content: center;

  > .main {
    width: 100%;
    max-width: 800px;
  }
}

.notes-header {
  display: flex;
  align-items: baseline;
  column-gap: 0.75rem;
  row-gap: 0.25rem;

  margin: 0 0.75rem;

  @media (max-width: 800px) {
    flex-direction: column;
    align-items: flex-start;

    margin-bottom: 0.375rem;
  }
}

.title-icon {
  width: 6rem;
  height: 6rem;
}

.title-name {
  font-size: 2rem;
  letter-spacing: 0.25rem;

  font-family: var(--font-unique);
}

.no-notes {
  margin: 2rem 0;
  color: var(--color-main-3);
  font-style: italic;
}

.notes-list-content {
  width: 100%;

  background-color: white;
  padding: 0.25rem 0.75rem;

  > .preface :global(p) {
    margin: 0.5rem 0;
  }
}

.epilog-text {
  display: flex;
  align-items: center;
  justify-content: center;
  column-gap: 0.5rem;

  margin: 2rem 0;
  padding: 0 1rem;
  font-size: 0.875rem;
  line-height: 1.25;
  color: var(--color-main-2);

  > .icon {
    width: 24px;
    height: 24px;
  }
}

.topic-info {
  color: var(--color-main-2);
}

.author-icon {
  margin: 2.5rem 0;
  display: flex;
  align-items: center;
  justify-content: center;

  > .icon {
    width: 4rem;
  }
}
</style>
