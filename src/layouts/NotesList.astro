---
import type { MDXInstance } from 'astro'
import { getCollection } from 'astro:content'
import type { SupportedLocales } from 'virtual:i18n'
import BubbleRect20 from './components/BubbleRect20.astro'
import GotoOverlayAstro from './components/GotoOverlayAstro.vue'
import NoteEntry, { type NoteEntryProps } from './components/NoteEntry.astro'
import NotesTopicGroup from './components/NotesTopicGroup.astro'
import ShowdownMask from './components/ShowdownMask.astro'
import { useI18n } from './i18n'
import NotesBase, { type NotesProps } from './NotesBase.astro'

interface NoteTopic {
  /** Topic name. */
  name: string
  /** Brief introduction to the topic.  */
  info?: string
}

export interface NotesByTopic extends NoteTopic {
  /** File path related to `/notes`. */
  entries: string[]
}

interface NoteEntriesByTopic extends NoteTopic {
  entries: NoteEntryProps[]
}

interface Props extends NotesProps {
  topics: NotesByTopic[]
}

const { locale = 'en', topics: rawTopics } = Astro.props
const { m } = useI18n(locale)

const topics: NoteEntriesByTopic[] = []

for (const rawTopic of rawTopics) {
  const filePaths = new Set(
    rawTopic.entries.map((entry) => `src/notes/${entry}`),
  )

  const notes = await getCollection('notes', (note) => {
    return filePaths.has(note.filePath ?? '')
  })

  const topic: NoteEntriesByTopic = {
    name: rawTopic.name,
    info: rawTopic.info,
    entries: notes.map((note) => ({
      title: note.data.title,
      route: note.data.route,
      date: note.data.created,
    })),
  }

  topics.push(topic)
}

const localePageMap: Record<SupportedLocales, string> = {
  en: '/notes/en',
  zh: '/notes/zh',
}

const NoteListPreface = (await import(
  `./components/NotesListPreface.${locale}.mdx`
) as MDXInstance<{}>).default
---

<NotesBase {...Astro.props}>
  <div class="notes-list">
    <main class="main">
      <h1 class="notes-list-title">{m('notesListTitle')}</h1>

      <BubbleRect20>
        <div class="notes-list-content">
          <div class="preface">
            <NoteListPreface />
            {topics.length == 0
              ? <div>No notes</div>
              : topics.map((topic) => (
                <NotesTopicGroup name={topic.name}>
                  {topic.entries.map((entry) => <NoteEntry entry={entry} />)}
                </NotesTopicGroup>
              ))}
          </div>
        </div>
      </BubbleRect20>
    </main>
  </div>

  <GotoOverlayAstro
    client:only="vue"
    locale={locale}
    locale-page-map={localePageMap}
  />
  <ShowdownMask />
</NotesBase>

<style lang="scss">
.notes-list {
  padding: 4rem 1rem 2rem 1rem;
  display: flex;
  justify-content: center;

  > .main {
    width: 100%;
    max-width: 800px;
  }

  @media (max-width: 800px) {
    padding: 7rem 0.5rem 2rem 0.5rem;
  }
}

.notes-list-title {
  font-size: 2rem;
  margin-bottom: 0.25rem;
  letter-spacing: 0.25rem;

  font-family: var(--font-unique);
}

.notes-list-content {
  width: 100%;

  background-color: white;
  padding: 0.25rem;

  > .preface :global(p) {
    margin: 0.5rem;
    vertical-align: text-bottom;
  }
}
</style>
