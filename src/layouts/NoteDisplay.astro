---
import '@styles/article.scss'
import IconBack from '@assets/icons/back.svg'
import IconLicense from '@assets/icons/license.svg'
import IconTimeUpdate from '@assets/icons/time-update.svg'
import IconTime from '@assets/icons/time.svg'
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'
import { capitalize } from 'remeda'
import BubbleRect16 from './components/BubbleRect16.astro'
import BubbleRect20 from './components/BubbleRect20.astro'
import DiscussionPrompt from './components/DiscussionPrompt.astro'
import NoteFooter from './components/NoteFooter.astro'
import TableOfContents from './components/TableOfContents.astro'
import { useI18n } from './i18n'
import NoteBase from './NoteBase.astro'

interface Props {
  note: CollectionEntry<'notes'>
}

const { note } = Astro.props
const locale = note.data.lang
const title = `${note.data.title} | i'D Notes`
const created = note.data.created
const updated = note.data.updated
const license = note.data.license

const { m } = useI18n(locale)
const { Content, headings } = await render(note)

function formatDate(date: Date) {
  return `${date.getFullYear()} / ${date.getMonth() + 1} / ${date.getDate()}`
}

const licenseKey = capitalize(license)
const licenseRefLinkMap: Record<string, string> = {
  cc: 'https://creativecommons.org/licenses/by-nc-sa/4.0/',
}
const licenseRefLink: string | undefined = licenseRefLinkMap[license]
const hasRefLink = typeof licenseRefLink !== 'undefined'
---

<NoteBase locale={locale} title={title}>
  <div class="note-display">
    <main class="main">
      <a class="note-back" href={`/notes/${locale}`}>
        <BubbleRect16>
          <div class="note-back-btn">
            <div class="icon"><IconBack /></div>
            <span>{m('backToNoteList')}</span>
          </div>
        </BubbleRect16>
      </a>

      <BubbleRect20>
        <div class="note-display-content">
          <h1 class="note-title">{note.data.title}</h1>

          <div class="note-meta-list">
            <div class="note-meta">
              <div class="icon"><IconTime /></div>
              <span>{m('dateCreated')}{formatDate(created)}</span>
            </div>

            {updated && (
              <div class="note-meta">
                <div class="icon"><IconTimeUpdate /></div>
                <span>{m('dateUpdated')}{formatDate(updated)}</span>
              </div>
            )}

            <div class="note-meta">
              <div class="icon"><IconLicense /></div>
              <a
                class:list={['name', { '-link': hasRefLink }]}
                href={licenseRefLink}
                target="_blank"
                rel="noopener noreferrer"
              >
                {m(`license${licenseKey}`)}
              </a>
            </div>
          </div>

          {headings.length > 0 && (
            <TableOfContents
              locale={locale}
              headings={headings}
            />
          )}

          <article class="note-article">
            <Content />
          </article>

          <div class="note-divider">
            <svg class="line">
              <line
                x1="0"
                y1="50%"
                x2="100%"
                y2="50%"
                stroke="currentColor"
                stroke-width="2"
                stroke-dasharray="12 14"
                stroke-linecap="round"
              />
            </svg>
          </div>

          <DiscussionPrompt />
          <NoteFooter />
        </div>
      </BubbleRect20>
    </main>
  </div>
</NoteBase>

<style lang="scss">
.note-display {
  padding: 2rem 1rem 2rem 1rem;
  display: flex;
  justify-content: center;

  > .main {
    width: 100%;
    max-width: 800px;
  }
}

.note-back {
  display: block;
  width: fit-content;
  margin-bottom: 0.75rem;

  color: var(--color-main);
  text-decoration: none;
}

.note-back-btn {
  display: flex;
  align-items: center;
  column-gap: 0.375rem;

  padding: 0.125rem 0.25rem;
  font-size: 0.875rem;
  color: var(--color-main);
  background-color: white;

  transition: color 0.125s ease;

  .note-back:hover & {
    color: var(--color-main-3);
  }

  > .icon {
    width: 1.5rem;
    height: 1.5rem;
  }
}

.note-display-content {
  width: 100%;

  background-color: white;
  padding: 0.25rem 0.75rem;
}

.note-title {
  margin: 1rem 0 0.5rem 0;
  font-size: 2rem;
  font-weight: normal;
  font-family: var(--font-unique);
  line-height: 1.25;
  color: var(--color-main);
}

.note-meta-list {
  display: flex;
  align-items: center;
  flex-wrap: wrap;

  column-gap: 1rem;
  row-gap: 0.25rem;

  color: var(--color-main-2);
  font-size: 0.875rem;
}

.note-meta {
  display: flex;
  align-items: center;
  column-gap: 0.25rem;

  > .icon {
    width: 1rem;
    height: 1rem;
  }

  > .name.-link {
    text-decoration: underline;
    color: var(--color-main-2);
  }

  &:hover > .name.-link {
    color: var(--color-main-3);
  }

  @media (max-width: 640px) {
    flex-basis: 100%;
  }
}

.note-divider {
  margin: 1rem 0;

  > .line {
    width: 100%;
    height: 4px;
    overflow: visible;
  }
}
</style>
