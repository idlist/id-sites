---
import type { SupportedLocales } from 'virtual:i18n'

interface Props {
  locale: SupportedLocales
}

const { locale } = Astro.props

function linkTemplate(text: string) {
  return `
<a
  href="https://github.com/idlist/id-sites/discussions"
  target="_blank"
  rel="noopener noreferrer"
>${text}</a>
`.trim()
}
---

<div class="discuss-prompt">
  {locale === 'en' && (
    <p>Really wanna discuss something with me?</p>
    <p>
      <span>Reach me via the contacts in my homepage, or </span>
      <Fragment set:html={linkTemplate('start a discussion')} />
      <span> in the GitHub repository of this site.</span>
    </p>
  )}
  {locale === 'zh' && (
    <p>真的很想找我聊聊？</p>
    <p>
      <span>通过首页的联系方式找到我，或者去这个站点的 GitHub 仓库</span>
      <Fragment set:html={linkTemplate('开个新讨论')} />
      <span>吧。</span>
    </p>
  )}
</div>

<style lang="scss">
.discuss-prompt {
  color: var(--color-main-3);
  font-size: 0.875rem;
  text-align: center;

  margin: 0.75rem 0;
}
</style>
