---
import type { SupportedLocales } from 'virtual:i18n'

interface Props {
  locale: SupportedLocales
}

const { locale } = Astro.props

function linkTemplate(text: string) {
  return `
<a
  href="https://github.com/idlist/id-sites/discussions"
  target="_blank"
  rel="noopener noreferrer"
>${text}</a>
`.trim()
}
---

<div class="discuss-prompt">
  {locale === 'en' && (
    <span>Really wanna discuss something with me?&nbsp;</span>
    <span>Reach me via the contacts in my homepage,&nbsp;</span>
    <span>or <Fragment set:html={linkTemplate('start a discussion')} /></span>
    <span>&nbsp;in the GitHub repository of this site.</span>
  )}
  {locale === 'zh' && (
    <span>真的很想找我聊聊？</span>
    <span>通过首页的联系方式找到我，</span>
    <span>或者去这个站点的 GitHub 仓库</span>
    <span><Fragment set:html={linkTemplate('开个新讨论')} />吧。</span>
  )}
</div>

<style lang="scss">
.discuss-prompt {
  color: var(--color-main-3);
  font-size: 0.875rem;
  text-align: center;

  margin: 0.75rem 0;

  > span {
    display: inline-block;
  }
}
</style>
