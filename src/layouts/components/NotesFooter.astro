---
import { useI18n } from '@layouts/i18n'
import { lastUpdate, yearCopyright } from '@src/meta.g'
import type { SupportedLocales } from 'virtual:i18n'

interface Props {
  locale?: SupportedLocales
}

const { locale = 'en' } = Astro.props
const { m } = useI18n(locale)

const yearBegin = 2026
const yearRange = yearCopyright === yearBegin
  ? `${yearBegin}`
  : `${yearBegin} - ${yearCopyright}`
---

<div class="notes-footer">
  <span>i'DLisT © {yearRange}</span>
  <span class="divider">|</span>
  <span>{m('lastUpdate')}{lastUpdate}</span>
</div>

<style lang="scss">
.notes-footer {
  display: flex;
  flex-direction: row;

  align-items: center;
  justify-content: center;
  padding: 0.25rem;

  text-align: center;
  font-size: 0.875rem;
  color: var(--color-main-3);

  @media (max-width: 800px) {
    flex-direction: column;
  }

  > .divider {
    padding: 0 0.5rem;

    @media (max-width: 800px) {
      display: none;
    }
  }
}
</style>
