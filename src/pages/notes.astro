---
import NoteBase from '@layouts/NoteBase.astro'
---

<NoteBase title="Redirecting..."></NoteBase>

<script>
import { guessLocaleWithStorage } from '@client/guess-locale'

const localeGuessed = guessLocaleWithStorage()

function getLocale() {
  if (localeGuessed.startsWith('zh')) return 'zh'
  return 'en'
}

window.location.href = `/notes/${getLocale()}`
</script>
