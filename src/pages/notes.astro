---
import NoteBase from '@layouts/NoteBase.astro'
---

<NoteBase title="Redirecting..."></NoteBase>

<script>
import { detectLocaleWithStorage } from '@client/detect-locale'

const localeDetected = detectLocaleWithStorage()

function getLocale() {
  if (localeDetected.startsWith('zh')) return 'zh'
  return 'en'
}

window.location.href = `/notes/${getLocale()}`
</script>
