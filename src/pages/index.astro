---
import HomePage from '@home/HomePage.vue'
import Base from '@layouts/Base.astro'
---

<Base title="i'DLisT | Spherical Vacuum">
  <HomePage client:only="vue" />
</Base>

<style is:global>
body {
  color: var(--color-sub);
  background-color: var(--color-main);

  /* Disable default scroll bar. */
  &::-webkit-scrollbar {
    display: none;
  }

  @supports not selector(::-webkit-scrollbar) {
    & {
      scrollbar-width: none;
    }
  }

  /* Temporary hack until there's more content */
  overflow-y: hidden;
}
</style>
